{
  "name": "@traderoom/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "kyc:to-storage": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/kyc-to-storage.ts",
    "db:tunnel": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/cloudsql-tunnel.ts",
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "dev:worker": "tsx watch --conditions=development --env-file-if-exists=../../.env src/worker.ts",
    "start:worker": "node dist/worker.js",
    "set-password": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/set-password.ts",
    "admin-role": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/admin-role.ts",
    "mail:test": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/mail-test.ts",
    "load-users": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/load-users.ts",
    "migrate": "tsx --conditions=development --env-file-if-exists=../../.env src/cli/migrate.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@google-cloud/cloud-sql-connector": "1.12.1",
    "@traderoom/shared": "0.1.0",
    "argon2": "0.45.2",
    "fastify": "5.12.8",
    "firebase-admin": "14.5.0",
    "google-auth-library": "11.3.3",
    "ioredis": "6.0.0",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
