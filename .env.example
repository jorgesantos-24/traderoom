# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info

# ---- API (apps/api) ----
API_HOST=127.0.0.1
API_PORT=3000
# Public origin used for CORS, cookies and password reset links
PUBLIC_ORIGIN=http://localhost:5173
# Secure cookies. Browsers accept them on http://localhost, so keep true in dev too.
COOKIE_SECURE=true
RATE_LIMIT_GLOBAL_PER_MIN=120
# Password reset e-mail (production). Without a key, reset e-mails are dropped (dev logs the link).
# Prod: the key comes from Secret Manager (traderoom-resend-api-key); the sender domain must be verified in Resend.
RESEND_API_KEY=
MAIL_FROM=Traderoom <nao-responda@example.com>
# Pix deposits/withdrawals (Novus Pagamentos). Private key from the dashboard: Integrações > Chave Privada > Revelar.
# Empty = deposits and withdrawals off. Never commit the real key.
NOVUS_API_KEY=
NOVUS_API_URL=https://api.novuspagamentos.com/api/v2
# Optional: secret (whsec_...) of a global webhook created in Integrações > Webhooks
NOVUS_WEBHOOK_SECRET=
# true in production: the gateway posts status changes to PUBLIC_ORIGIN/api/webhooks/novus.
# false in dev (localhost is unreachable); the app then asks the gateway for the status itself.
NOVUS_POSTBACKS=false

# ---- WS gateway (apps/ws) ----
WS_HOST=127.0.0.1
WS_PORT=3001
# Relay (asset reload, 1 s snapshots) + session checks on WS handshakes
WS_DATABASE_POOL_MAX=8

# ---- Settlement worker (apps/api, src/worker.ts) ----
WORKER_HOST=127.0.0.1
# /metrics and /healthz (internal)
WORKER_PORT=3002
WORKER_DATABASE_POOL_MAX=6
# price_snapshots older than this are deleted hourly by the worker
SNAPSHOT_RETENTION_DAYS=7

# ---- Postgres ----
# Dev: matches docker-compose.yml. Prod: built from Secret Manager by infra/deploy.sh
DATABASE_URL=postgres://traderoom:traderoom_dev@127.0.0.1:5432/traderoom
DATABASE_POOL_MAX=20

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379

# ---- Market data ----
BINANCE_WS_URL=wss://data-stream.binance.vision:443/stream
BINANCE_REST_URL=https://data-api.binance.vision
BINANCE_BACKUP_WS_URL=wss://stream.binance.com:443/stream
# Asset is "stale" (orders refused) after this long without a tick
FEED_STALE_MS=2000
ORDER_ENTRY_DELAY_MS=500
# /api/health returns 503 if the newest tick is older than this
HEALTH_FEED_MAX_AGE_MS=5000

# ---- Docker Compose (dev only) ----
POSTGRES_USER=traderoom
POSTGRES_PASSWORD=traderoom_dev
POSTGRES_DB=traderoom
POSTGRES_PORT=5432
REDIS_PORT=6379

# KYC photos in Firebase Storage. Leave empty to keep them in Postgres (dev/tests).
FIREBASE_STORAGE_BUCKET=
# Service account JSON (Firebase console > Configurações do projeto > Contas de serviço > Gerar nova chave privada).
# Keep it outside git, e.g. secrets/firebase-admin.json. Empty: Application Default Credentials.
FIREBASE_CREDENTIALS_FILE=

# Maintenance only (local dev stays on docker Postgres): `npm run db:tunnel` reaches the production
# Cloud SQL instance on a local port:
#   DATABASE_URL=postgres://traderoom:<senha do Secret Manager traderoom-db-password>@127.0.0.1:5433/traderoom
CLOUD_SQL_INSTANCE=
CLOUD_SQL_LOCAL_PORT=5433
