# Deploy settings for the Firebase project traderoom-48951. No secrets here.
#   source infra/firebase.env
#   export TRADEROOM_DOMAIN=seudominio.com ACME_EMAIL=voce@seudominio.com
#   export EAGLE_CLIENT_ID=... EAGLE_PUBLIC_KEY=... EAGLE_SECRET_KEY=...  SMTP_PASS=...   # typed in the shell, go to Secret Manager
#   infra/deploy.sh provision
export GCP_PROJECT=traderoom-48951
export REGION=southamerica-east1
export ZONE=southamerica-east1-c

# The Postgres instance Firebase SQL Connect created (adopted and hardened by `provision`).
# Same zone as the instance, so the VM-to-database round trip stays inside one zone.
export SQL=traderoom-48951-instance
# Our own database inside it; SQL Connect's `traderoom-48951-database` is left alone.
export DB_NAME=traderoom
# Size for launch. Moving the instance needs SQL_RESIZE=1 and ends the SQL Connect free trial.
export SQL_TIER=db-g1-small

export FIREBASE_STORAGE_BUCKET=traderoom-48951.firebasestorage.app

export TRADEROOM_DOMAIN=kydeninvest.com
# www and the old sslip.io address redirect to the domain (payment webhooks still answered there).
export TRADEROOM_REDIRECT_FROM='www.kydeninvest.com 35-247-193-91.sslip.io'

# Password reset e-mails: Hostinger mailbox (smtp.hostinger.com:465). Its password goes in SMTP_PASS (Secret Manager).
export MAIL_FROM='Kyden <support@kydeninvest.com>'
