[Unit]
Description=Traderoom secrets from Secret Manager into /run/traderoom
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/opt/traderoom/bin/fetch-secrets.sh
# Metadata server or Secret Manager may be briefly unreachable right after boot.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
