# Traderoom — Caddy 2 on the VM. TLS certificates are automatic (Let's Encrypt / ZeroSSL).
# {$TRADEROOM_DOMAIN} and {$TRADEROOM_ACME_EMAIL} come from /etc/default/caddy (written by vm-setup.sh).
#
# nginx → Caddy equivalents asked for in the spec:
#   proxy_read_timeout 3600s → Caddy sets no read/idle timeout on an upgraded WebSocket, so it stays
#                              open as long as both ends want; the gateway pings every 20 s and drops
#                              dead peers after 40 s. `stream_timeout 24h` caps a single stream.
#   proxy_buffering off      → `flush_interval -1` (write every frame through immediately).
#   On `systemctl reload caddy`, open WebSockets get `stream_close_delay` (5 min) before closing,
#   so config reloads do not disconnect every trader at once.

{
	email {$TRADEROOM_ACME_EMAIL}
	servers {
		# Caddy is the edge: no trusted_proxies, so client X-Forwarded-For headers are replaced, not trusted.
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

{$TRADEROOM_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		# 'unsafe-inline' for styles only: the chart library and progress bars set inline style attributes.
		# blob: in img-src: the KYC page previews the re-encoded photo before upload.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss://{$TRADEROOM_DOMAIN}; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		-Server
	}

	# Internal endpoints are never published (they also live on other ports).
	@internal path /metrics /metrics/* /healthz
	handle @internal {
		respond 404
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /ws {
		reverse_proxy 127.0.0.1:3001 {
			flush_interval -1
			stream_timeout 24h
			stream_close_delay 5m
		}
	}

	# Single-page app: hashed assets cached forever, everything else falls back to index.html.
	handle {
		root * /opt/traderoom/current/apps/web/dist
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/traderoom.log {
			roll_size 50MiB
			roll_keep 5
		}
		format json
	}
}

# Plain HTTP → HTTPS is automatic for {$TRADEROOM_DOMAIN}.
